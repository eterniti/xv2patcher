	<Patch name="IncreaseChaselMemory" type="notify" search_start="0x3AB2F4" >
		<Instruction code="45 33 C9" comment="xor r9d, r9d" />
		<Instruction code="33 D2" comment="xor edx, edx" />
		<Instruction code="B9 30290000" comment="mov ecx, 2930h" />
		<Instruction code="45 8D 41 FF" comment="lea r8d, [r9-1]" />
		<Instruction code="FF 15 XXXXXXXX" comment="call operator new" />
		<Instruction code="4C 8B D0" comment="mov r10, rax" />
		
		<Notify inst_index="2" inst_offset="1" value="IncreaseChaselMemory" />
	</Patch>
	
